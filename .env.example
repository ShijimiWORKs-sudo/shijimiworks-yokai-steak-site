# Contactフォーム送信用 (Resend: https://resend.com)
# 1. resend.com で無料アカウントを作成し、APIキーを発行する
# 2. 独自ドメインを認証していない場合、送信元は onboarding@resend.dev のままにし、
#    CONTACT_TO_EMAIL は Resend に登録したご自身のメールアドレスと同じにする
#    （サンドボックス状態では、登録メールアドレス以外への送信が制限されます）
RESEND_API_KEY=
CONTACT_TO_EMAIL=shijimiworks.takaki@gmail.com
CONTACT_FROM_EMAIL="ShijimiWORKs Contact <onboarding@resend.dev>"

# /admin を簡易Basic認証で保護するためのユーザー名・パスワード
# 両方設定しない場合、/admin は常に401 (アクセス不可) になります
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
